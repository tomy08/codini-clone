---
import Layout from '../../layouts/Layout.astro'

import ProductCollection from '../../components/shared/products/ProductCollection.astro'
import ProductCard from '../../components/shared/products/ProductCard.astro'
import Breadcrumb from '../../components/shared/Breadcrumb.astro'
import type { Product } from '../../types'
import { getProducts } from '../../utils/products'
import { getCategory, categoryList } from '../../utils/category'

export async function getStaticPaths() {
  return [
    { params: { category: 'panales' } },
    { params: { category: 'toallitas' } },
    { params: { category: 'cremas-y-oleos' } },
    { params: { category: 'accesorios' } },
  ]
}

const { category } = Astro.params

const categoryReformed = getCategory(category)

const allProducts = await getProducts()

const filtered = allProducts
  .filter((product: Product) => product.category === categoryReformed)
  .sort((a: Product, b: Product) => a.price - b.price)
---

<Layout title={`${categoryReformed} - Pañalera Vera`}>
  <Breadcrumb />
  <ProductCollection>
    {filtered.map((product: Product) => <ProductCard product={product} />)}
  </ProductCollection>
</Layout>
