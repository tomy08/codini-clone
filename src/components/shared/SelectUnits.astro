---
interface Props {
  units: string[]
}

const { units } = Astro.props
---

<div class="relative inline-flex items-center rounded border border-gray-200 h-10 px-3 gap-2 cursor-pointer min-w-[90px]">
  <!-- Ícono izquierdo -->
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h10M7 12h6M7 17h8" />
  </svg>

  <!-- Texto del valor seleccionado -->
  <span id="unit-display" class="text-sm text-gray-700 font-medium flex-1 text-center select-none">
    {units[0]}
  </span>

  <!-- Flecha derecha -->
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
  </svg>

  <!-- Select invisible encima de todo -->
  <select
    id="unit-select"
    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer text-black"
    style="color: black;"
  >
    {units.map((unit) => (
      <option value={unit}>{unit}</option>
    ))}
  </select>
</div>

<script>
  const select = document.getElementById('unit-select') as HTMLSelectElement
  const display = document.getElementById('unit-display')

  select?.addEventListener('change', () => {
    if (display) display.textContent = select.value
  })
</script>
